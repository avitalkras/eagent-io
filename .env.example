# Copy this file to .env and fill in real values. .env is git-ignored —
# NEVER commit real secrets.

# SQLAlchemy connection string for the Postgres warehouse built in Phase 1.
DATABASE_URL=postgresql+psycopg2://localhost:5432/eagent

# Hunter.io API key for recruiter-contact enrichment (Phase 2).
# Leave blank to run RecruiterEnricher in fallback-only mode (generic
# careers@ email guesses instead of real lookups).
HUNTER_API_KEY=

# Which eagent.ats.llm provider scripts/score_unscored_jobs.py uses for
# unattended runs — "groq" or "gemini" (Phase 7). Defaults to "groq" if unset.
LLM_PROVIDER=groq

# API key matching whichever LLM_PROVIDER is selected above (Phase 3/7).
GROQ_API_KEY=
GEMINI_API_KEY=

# Telegram Bot API credentials for scripts/notify.py's high-score digest
# (Phase 7). Leave both blank to skip notifications without failing the
# harvest run — see docs/08-going-live-secrets-and-migrations.md §2 for how
# to get these from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
